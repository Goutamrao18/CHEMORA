# CHEMORA Environment Configuration

# Server & Site Configuration
PORT=3000
SITE_URL=https://chemora.work.gd

# Supabase Authentication & Database
SUPABASE_URL=https://mcwadkgzplurjtstrhdd.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://mcwadkgzplurjtstrhdd.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_VIDEO_CDN_URL=https://mcwadkgzplurjtstrhdd.supabase.co/storage/v1/object/public/chemora-videos

# Admin Security & Stateless Sessions (REQUIRED IN PRODUCTION)
# 64+ hex characters or high-entropy passphrase for HMAC-SHA256 session signing
ADMIN_SESSION_SECRET=
# 32-byte key or passphrase for AES-256-GCM 2FA secret encryption at rest
ADMIN_2FA_ENCRYPTION_KEY=

# Local Development Admin Fallback (ONLY active when NODE_ENV=development and ALLOW_DEV_ADMIN=true)
# STRICTLY DISABLED and impossible in production mode.
ALLOW_DEV_ADMIN=false
DEV_ADMIN_EMAIL=dev-admin@chemora.local
DEV_ADMIN_PASSWORD=
DEV_ADMIN_2FA_ENABLED=false
DEV_ADMIN_2FA_SECRET=

# Rate Limiting & Distributed Counter Store (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI Tutor & Gemini Operational Intelligence
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_CAP=50
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_FALLBACK_MODEL=
ALLOW_DEV_AUTH_FALLBACK=false