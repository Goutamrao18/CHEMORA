# ==============================================================================
# CHEMORA Environment Configuration Template (.env.example)
# Note: Never commit secrets or .env to version control.
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=development

# Allowed Origins for CORS (comma-separated origins)
# Example: http://localhost:3000,https://chemora.work.gd,https://chemora.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider Keys (Server-Side Only - never exposed to client)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Supabase Database & Auth (Optional - falls back to resilient in-memory repository)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client Supabase Environment Variables (Optional)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=